# Local development only; override both values in production.
MYSQL_USERNAME=root
MYSQL_PASSWORD=123
# Development only. Set the same strong secret on gateway and auth in production.
JWT_SECRET=development-only-secret-change-me-please-use-env-var-32-bytes-minimum
# Supply a rotated, least-privilege OSS key locally; do not commit real credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# CAMPUS_ENV and NACOS_CONFIG_NAMESPACE select bootstrap imports; set them in
# the operating-system environment before startup when using non-default values.
